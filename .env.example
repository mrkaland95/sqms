# The port that express/"web server" will use to recieve connections.
# Should be set to 5000 while developing, or using the docker compose methods.
PORT=
# A string used to sign cookies. It's crucial for security that this is a long, randomized string.
# Ensures the safety of connections between the web server and client.
SESSION_SECRET=
# The discord app token the server will use to connect perform actions as a bot.
# Primarily used to retrieve users and roles from a discord server, for authorization purposes.
DISCORD_APP_TOKEN=
# The discord guild ID of the server that this bot will be situated in.
DISCORD_GUILD_ID=
# The public key of discord OAuth process. Generate this in the discord developer portal.
DISCORD_OAUTH_CLIENT_PUBLIC=
# The secret key of the discord OAuth process. Generate this in the discord developer portal
DISCORD_OAUTH_CLIENT_SECRET=
# The link used to redirect from discord OAuth2 back to this server.
# Generate this from the discord developer portal
DISCORD_OUATH_REDIRECT_URL=
# Whether the server should log updates to whitelists to a discord channel
DISCORD_LOGGING_ENABLED=
# The channel ID of the channel that the server will put updates to whitelists in.
DISCORD_LOGGING_CHANNEL=
# The string used by the mongoose database module to connect to a Mongo database.
# Must include user+password if your MongoDB has that enabled.
MONGO_DB_CONNECTION_STRING=mongodb://127.0.0.1:27017/whitelist-management
# The time that a user's session will last, i.e the amount of time they can stay logged in before they have to authenticate again.
COOKIE_MAX_AGE_HOURS=1
# Used on the frontend for defining things such as titles.
ORGANIZATION_NAME=
#
DEBUG=
# The environment that node will run in
NODE_ENV=testing
# These IDs essentially define discord roles in which users with the role will have effectively "super user" powers,
# I.e the ability to perform any action from the web interface.
# It's crucial to only give this to roles with trusted people.
DISCORD_ROLES_AUTHORIZED_FOR_ADMIN=[]
#
LOGGING_LEVEL=info